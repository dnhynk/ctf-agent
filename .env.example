# Safe sample. Copy non-secret values as needed.
#
# Secrets do NOT belong in this file or anywhere in the repository.
# The canonical secret location is ~/.config/kisia-agent/secrets.env with mode 0600:
#
#   OPENAI_API_KEY=sk-proj-...
#   OPENAI_PROJECT_ID=proj_...        # only when an explicit project must be selected

KISIA_DATA_DIR=var/kisia
KISIA_DEPLOYMENT_CLASS=local
KISIA_BIND_HOST=127.0.0.1
KISIA_BIND_PORT=8080
KISIA_MAX_WORKERS=1
KISIA_SUBMISSION_MODE=manual
KISIA_OPENAI_STORE=false

# Contest window: ISO 8601 with an explicit offset. Normalized to UTC, displayed in Asia/Seoul.
# KISIA_CONTEST_START=2026-01-01T00:00:00+09:00
# KISIA_CONTEST_END=2026-01-01T12:00:00+09:00

# Independent permissions remain false until the referenced contest rules are reviewed.
KISIA_RULES_REFERENCE=
KISIA_POLICY_ACTOR=
KISIA_POLICY_ACKNOWLEDGED_AT=
KISIA_ALLOW_EXTERNAL_AI=false
KISIA_ALLOW_VPS=false
KISIA_ALLOW_NETWORK_AUTOMATION=false
KISIA_ALLOW_AUTO_SUBMIT=false
